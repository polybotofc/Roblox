<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <img src="https://images.rbxcdn.com/79831dfb6bea68d45a96e6a059dba2c0.svg" alt="Roblox">
      <div class="auth-logo-text">Login</div>
    </div>

    <% if (banned) { %>
      <div class="alert alert-error">Your account has been banned.</div>
    <% } %>

    <% if (errors.length > 0) { %>
      <% errors.forEach(function(err) { %>
        <div class="alert alert-error"><%= err.msg %></div>
      <% }); %>
    <% } %>

    <form method="POST" action="/auth/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label class="form-label">Username or Email</label>
        <input type="text" name="identifier" class="form-input" placeholder="Username or Email" required autofocus>
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-input" placeholder="Password" required>
      </div>
      <div class="form-group">
        <label class="form-checkbox">
          <input type="checkbox" name="remember" value="1">
          Remember Me
        </label>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Login</button>
    </form>

    <div class="auth-footer">
      Don't have an account? <a href="/auth/register">Sign Up</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
