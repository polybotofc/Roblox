<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="main-content">
  <div class="news-page">
    <h1 class="section-title" style="margin-bottom:16px">Edit News</h1>

    <div class="settings-section">
      <% if (errors.length > 0) { %>
        <% errors.forEach(function(err) { %>
          <div class="alert alert-error"><%= err.msg %></div>
        <% }); %>
      <% } %>

      <form method="POST" action="/news/edit/<%= article.id %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label class="form-label">Title</label>
          <input type="text" name="title" class="form-input" value="<%= article.title %>" required>
        </div>
        <div class="form-group">
          <label class="form-label">Category</label>
          <select name="category" class="form-input">
            <option value="announcement" <%= article.category === 'announcement' ? 'selected' : '' %>>Announcement</option>
            <option value="event" <%= article.category === 'event' ? 'selected' : '' %>>Event</option>
            <option value="update" <%= article.category === 'update' ? 'selected' : '' %>>Update</option>
            <option value="maintenance" <%= article.category === 'maintenance' ? 'selected' : '' %>>Maintenance</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Body</label>
          <textarea name="body" class="reply-textarea" style="min-height:200px" required><%= article.body %></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Update</button>
        <a href="/news" class="btn btn-outline" style="margin-left:8px">Cancel</a>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
