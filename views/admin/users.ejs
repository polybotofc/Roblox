<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="main-content">
  <div class="admin-page">
    <div class="admin-header">
      <h1>Manage Users</h1>
    </div>

    <div class="admin-nav">
      <a href="/admin">Dashboard</a>
      <a href="/admin/users">Manage Users</a>
      <a href="/news/create">Create News</a>
    </div>

    <!-- Search -->
    <div class="search-bar" style="margin-bottom:16px">
      <form action="/admin/users" method="GET">
        <input type="text" name="search" class="form-input" placeholder="Search users..." value="<%= search %>">
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
    </div>

    <table class="admin-table">
      <thead>
        <tr>
          <th>User</th>
          <th>Email</th>
          <th>Role</th>
          <th>Status</th>
          <th>Joined</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function(u) { %>
          <tr>
            <td>
              <img src="<%= u.roblox_avatar_url %>" alt="" class="admin-avatar">
              <a href="/profile/<%= u.username %>"><%= u.username %></a>
            </td>
            <td><%= u.email %></td>
            <td><span class="post-user-role role-<%= u.role %>"><%= u.role %></span></td>
            <td>
              <% if (u.is_banned) { %>
                <span style="color:#e34d4d;font-weight:600">Banned</span>
              <% } else { %>
                <span style="color:#02b757;font-weight:600">Active</span>
              <% } %>
            </td>
            <td><%= new Date(u.created_at).toLocaleDateString() %></td>
            <td>
              <div style="display:flex;gap:4px;flex-wrap:wrap">
                <% if (!u.is_banned && u.role !== 'owner') { %>
                  <form method="POST" action="/admin/ban/<%= u.id %>" style="display:inline">
                    <input type="hidden" name="reason" value="Banned by admin">
                    <button type="submit" class="btn btn-red btn-sm" onclick="return confirm('Ban this user?')">Ban</button>
                  </form>
                <% } %>
                <% if (u.is_banned) { %>
                  <form method="POST" action="/admin/unban/<%= u.id %>" style="display:inline">
                    <button type="submit" class="btn btn-green btn-sm">Unban</button>
                  </form>
                <% } %>
                <% if (user.role === 'owner' && u.id !== user.id) { %>
                  <form method="POST" action="/admin/role/<%= u.id %>" style="display:inline">
                    <select name="role" class="form-input" style="width:auto;padding:4px 6px;font-size:11px">
                      <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>User</option>
                      <option value="moderator" <%= u.role === 'moderator' ? 'selected' : '' %>>Mod</option>
                      <option value="administrator" <%= u.role === 'administrator' ? 'selected' : '' %>>Admin</option>
                      <option value="owner" <%= u.role === 'owner' ? 'selected' : '' %>>Owner</option>
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm">Set</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% for (var i = 1; i <= totalPages; i++) { %>
          <a href="/admin/users?page=<%= i %>&search=<%= search %>" class="<%= i === page ? 'active' : '' %>"><%= i %></a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
